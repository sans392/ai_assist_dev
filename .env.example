# Ollama URL — use the container name from your Ollama docker-compose service
# Example: if your Ollama service is named "ollama", use http://ollama:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3
CORS_ORIGINS=["http://localhost:3000"]

# Logging: DEBUG shows full request payloads, INFO shows summary
LOG_LEVEL=INFO
